{
    "root": true,
    "ignorePatterns": ["**/*"],
    "plugins": ["@nx"],
    "overrides": [
        {
            "files": ["*.ts", "*.tsx", "*.js", "*.jsx"],
            "rules": {
                "@nx/enforce-module-boundaries": [
                    "error",
                    {
                        "allow": [],
                        "depConstraints": [
                            {
                                "sourceTag": "*",
                                "onlyDependOnLibsWithTags": ["*"]
                            },
                            {
                                "sourceTag": "scope:design-system",
                                "onlyDependOnLibsWithTags": ["scope:design-system"]
                            },
                            {
                                "sourceTag": "scope:frontend",
                                "onlyDependOnLibsWithTags": [
                                    "scope:frontend",
                                    "scope:design-system"
                                ]
                            },
                            {
                                "sourceTag": "scope:design-backend",
                                "onlyDependOnLibsWithTags": ["scope:design-backend"]
                            }
                        ]
                    }
                ]
            }
        },
        {
            "files": ["*.ts", "*.tsx"],
            "extends": ["plugin:@nx/typescript"],
            "rules": {}
        },
        {
            "files": ["*.js", "*.jsx"],
            "extends": ["plugin:@nx/javascript"],
            "rules": {}
        },
        {
            "files": ["*.spec.ts", "*.spec.tsx", "*.spec.js", "*.spec.jsx"],
            "env": {
                "jest": true
            },
            "rules": {}
        }
    ]
}
